--// Funções utilitárias
local function safeNumberValue(parent, name)
	if not parent then return nil end
	local v = parent:FindFirstChild(name)
	if v and (type(v.Value) == "number" or tonumber(v.Value) ~= nil) then
		return tonumber(v.Value)
	end
	return nil
end

local function getPlayerTeam(player)
	if not player then return nil end
	local status = player:FindFirstChild("Status")
	if not status then return nil end
	local team = status:FindFirstChild("Team")
	if not team then return nil end
	return tostring(team.Value)
end

local function isEnemy(player)
	local myTeam = getPlayerTeam(LocalPlayer)
	local otherTeam = getPlayerTeam(player)
	if not myTeam or not otherTeam then return false end
	return myTeam ~= otherTeam
end

-- Busca robusta por HumanoidRootPart (vários caminhos que você mencionou)
local function findHRP(player)
	-- 1) Character.HumanoidRootPart
	if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		return player.Character:FindFirstChild("HumanoidRootPart"), player.Character
	end
	-- 2) player.Ragdoll.HumanoidRootPart (você mencionou esse caminho)
	local ok, rag = pcall(function() return player:FindFirstChild("Ragdoll") end)
	if ok and rag and rag:FindFirstChild("HumanoidRootPart") then
		return rag:FindFirstChild("HumanoidRootPart"), rag
	end
	-- 3) Character.Ragdoll.HumanoidRootPart (alguns jogos colocam ragdoll dentro do character)
	if player.Character and player.Character:FindFirstChild("Ragdoll") and player.Character.Ragdoll:FindFirstChild("HumanoidRootPart") then
		return player.Character.Ragdoll:FindFirstChild("HumanoidRootPart"), player.Character.Ragdoll
	end
	-- 4) workspace[player.Name].HumanoidRootPart
	local wsModel = Workspace:FindFirstChild(player.Name)
	if wsModel and wsModel:FindFirstChild("HumanoidRootPart") then
		return wsModel:FindFirstChild("HumanoidRootPart"), wsModel
	end
	-- não achou
	return nil, nil
end

--// Drawing skeleton helpers (SEU CÓDIGO adaptado)
local function createLine(color)
	local line = Drawing.new("Line")
	line.Visible = false
	line.Color = color or Color3.fromRGB(255, 0, 0)
	line.Thickness = 2
	line.Transparency = 1
	return line
end

local function drawSkeleton(player)
	if not getPlayerESP() then
		-- desligado pelo toggle: garantir que as linhas estejam invisíveis
		if espLines[player] then
			for _, l in ipairs(espLines[player]) do
				l.Visible = false
			end
		end
		return
	end

	local character = player.Character
	if not character then return end

	local bonePairs = {
		{"Head", "UpperTorso"},
		{"UpperTorso", "LowerTorso"},
		{"UpperTorso", "LeftUpperArm"},
		{"LeftUpperArm", "LeftLowerArm"},
		{"UpperTorso", "RightUpperArm"},
		{"RightUpperArm", "RightLowerArm"},
		{"LowerTorso", "LeftUpperLeg"},
		{"LeftUpperLeg", "LeftLowerLeg"},
		{"LowerTorso", "RightUpperLeg"},
		{"RightUpperLeg", "RightLowerLeg"},
	}

	if not espLines[player] then
		espLines[player] = {}
		for i = 1, #bonePairs do
			table.insert(espLines[player], createLine(teamColors[getPlayerTeam(player)] or Color3.fromRGB(255,0,0)))
		end
	end

	for i, pair in ipairs(bonePairs) do
		local part0 = character:FindFirstChild(pair[1])
		local part1 = character:FindFirstChild(pair[2])
		local line = espLines[player][i]

		if part0 and part1 and Camera then
			local pos0, on0 = Camera:WorldToViewportPoint(part0.Position)
			local pos1, on1 = Camera:WorldToViewportPoint(part1.Position)
			if on0 and on1 then
				line.From = Vector2.new(pos0.X, pos0.Y)
				line.To = Vector2.new(pos1.X, pos1.Y)
				line.Visible = true
			else
				line.Visible = false
			end
		else
			if line then line.Visible = false end
		end
	end
end

local function clearSkeleton(player)
	if espLines[player] then
		for _, line in ipairs(espLines[player]) do
			pcall(function() line:Remove() end)
		end
		espLines[player] = nil
	end
end

--// Health bar + Highlight + Name — baseado no seu código da Healt bar
local function createESP(player)
	if not player or player == LocalPlayer then return end
	if espObjects[player] then return end

	-- checar time
	local team = getPlayerTeam(player)
	local localTeam = getPlayerTeam(LocalPlayer)
	if not team then return end
	if team == localTeam then return end

	-- checar HRP
	local hrp, model = findHRP(player)
	if not hrp then return end

	-- Highlight (parent no CoreGui como você usou)
	local highlight = Instance.new("Highlight")
	highlight.Adornee = model or (player.Character and player.Character) or hrp
	highlight.FillColor = teamColors[team] or Color3.new(1,1,1)
	highlight.OutlineColor = Color3.new(1,1,1)
	highlight.Parent = CoreGui
	highlight.Name = player.Name.."_Highlight"
	highlight.Enabled = getPlayerESP() -- inicia conforme toggle

	-- Name ESP (BillboardGui)
	local nameGui = Instance.new("BillboardGui")
	nameGui.Adornee = hrp
	nameGui.Size = UDim2.new(0, 140, 0, 22)
	nameGui.StudsOffset = Vector3.new(0, 3.2, 0)
	nameGui.AlwaysOnTop = true
	nameGui.Parent = CoreGui
	nameGui.Name = player.Name.."_NameGui"

	local nameLbl = Instance.new("TextLabel", nameGui)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Size = UDim2.new(1,0,1,0)
	nameLbl.TextScaled = true
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextColor3 = highlight.FillColor
	nameLbl.TextStrokeTransparency = 0.5
	nameLbl.Text = player.Name
	nameGui.Enabled = getNameESP()

	-- Health GUI (usando seu design)
	local healthGui = Instance.new("BillboardGui")
	healthGui.Adornee = hrp
	healthGui.Size = UDim2.new(0, 20, 0, 80)
	healthGui.StudsOffset = Vector3.new(-2.5, 2, 0)
	healthGui.AlwaysOnTop = true
	healthGui.Parent = CoreGui
	healthGui.Name = player.Name.."_HealthGui"
	healthGui.Enabled = getHealthESP()

	local bg = Instance.new("Frame", healthGui)
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.new(0, 0, 0)
	bg.BorderSizePixel = 1

	local healthBar = Instance.new("Frame", bg)
	healthBar.BackgroundColor3 = Color3.new(0, 1, 0)
	healthBar.AnchorPoint = Vector2.new(0, 1)
	healthBar.Position = UDim2.new(0, 0, 1, 0)
	healthBar.Size = UDim2.new(1, 0, 1, 0)

	local healthText = Instance.new("TextLabel", bg)
	healthText.Size = UDim2.new(1, 0, 1, 0)
	healthText.BackgroundTransparency = 1
	healthText.TextColor3 = Color3.new(1,1,1)
	healthText.Font = Enum.Font.GothamBold
	healthText.TextScaled = true
	healthText.TextStrokeColor3 = Color3.new(0, 0, 0)
	healthText.TextStrokeTransparency = 0
	healthText.Text = "100/100"

	espObjects[player] = {
		player = player,
		highlight = highlight,
		nameGui = nameGui,
		nameLbl = nameLbl,
		healthGui = healthGui,
		healthBar = healthBar,
		healthText = healthText,
		model = model,
		hrp = hrp
	}
end

local function cleanupESP(player)
	if not player then return end
	-- skeleton
	clearSkeleton(player)
	-- GUIs/highlight
	local o = espObjects[player]
	if o then
		pcall(function()
			if o.highlight and o.highlight.Parent then o.highlight:Destroy() end
			if o.nameGui and o.nameGui.Parent then o.nameGui:Destroy() end
			if o.healthGui and o.healthGui.Parent then o.healthGui:Destroy() end
		end)
		espObjects[player] = nil
	end
end

-- Atualiza as ESPs (chamado a cada RenderStepped)
local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			-- não mostramos ESP do próprio localplayer
			if espObjects[player] then cleanupESP(player) end
		else
			if isEnemy(player) then
				-- garantir objetos
				if not espObjects[player] then
					createESP(player)
				end

				local o = espObjects[player]
				if o then
					-- atualizar highlight (cor e ativação)
					local team = getPlayerTeam(player)
					local color = teamColors[team] or Color3.fromRGB(255,255,255)
					if o.highlight then
						o.highlight.FillColor = color
						o.highlight.OutlineColor = color
						o.highlight.Enabled = getPlayerESP()
					end

					-- Name
					if o.nameLbl then
						o.nameLbl.Text = player.Name
						o.nameLbl.TextColor3 = color
						o.nameGui.Enabled = getNameESP()
					end

					-- Health: ler NRPBS.Health / MaxHealth (com fallback)
					if o.healthBar and o.healthText then
						if getHealthESP() then
							local hp, maxHp = 100, 100
							local nrpbs = player:FindFirstChild("NRPBS")
							if nrpbs then
								local h = safeNumberValue(nrpbs, "Health")
								local m = safeNumberValue(nrpbs, "MaxHealth")
								if h then hp = h end
								if m then maxHp = m end
							else
								-- fallback humanoid
								local humanoid = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
								if humanoid then
									hp = tonumber(humanoid.Health) or hp
									maxHp = tonumber(humanoid.MaxHealth) or maxHp
								end
							end

							if maxHp == 0 then maxHp = 1 end
							local ratio = math.clamp(hp / maxHp, 0, 1)
							o.healthText.Text = string.format("%d/%d", math.floor(hp), math.floor(maxHp))

							local col = (ratio > 0.7) and Color3.fromRGB(0,255,0)
									or (ratio > 0.4) and Color3.fromRGB(255,165,0)
									or Color3.fromRGB(255,0,0)
							-- Tween suave (se falhar, aplica direto)
							local ok, err = pcall(function()
								TweenService:Create(o.healthBar, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
									{Size = UDim2.new(1, 0, ratio, 0), BackgroundColor3 = col}):Play()
							end)
							if not ok then
								o.healthBar.Size = UDim2.new(1,0,ratio,0)
								o.healthBar.BackgroundColor3 = col
							end
							o.healthGui.Enabled = true
						else
							o.healthGui.Enabled = false
						end
					end

					-- Skeleton (desenha apenas se PlayerESP estiver ligado)
					if getPlayerESP() then
						drawSkeleton(player)
					else
						clearSkeleton(player)
					end
				end
			else
				-- mesmo time ou sem time -> destruir/quitar ESP
				if espObjects[player] then cleanupESP(player) end
			end
		end
	end
end

-- Eventos
