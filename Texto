local function createSwitch(labelText, defaultOn)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, -12, 0, 44)
	holder.Position = UDim2.new(0, 6, 0, 0)
	holder.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
	holder.BorderSizePixel = 0
	holder.Parent = scrollFrame

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -80, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText
	lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 18
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = holder

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 64, 0, 28)
	btn.Position = UDim2.new(1, -74, 0.5, -14)
	btn.Text = ""
	btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	btn.AutoButtonColor = false
	btn.Parent = holder

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 26, 0, 26)
	knob.Position = UDim2.new(0, 1, 0, 1)
	knob.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	knob.BorderSizePixel = 0
	knob.Parent = btn

	local uiCorner1, uiCorner2 = Instance.new("UICorner"), Instance.new("UICorner")
	uiCorner1.CornerRadius = UDim.new(0, 14); uiCorner1.Parent = btn
	uiCorner2.CornerRadius = UDim.new(0, 13); uiCorner2.Parent = knob

	local state = defaultOn and true or false
	local function apply(on)
		state = on
		local targetX = on and 37 or 1
		local bg = on and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(100, 100, 100)
		TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, targetX, 0, 1)}):Play()
		TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = bg}):Play()
	end
	btn.MouseButton1Click:Connect(function() apply(not state) end)
	apply(state)

	return function() return state end, apply
end

