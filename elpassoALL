-- ALT DIREITO
local guiVisible = true

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end

	if input.KeyCode == Enum.KeyCode.RightAlt then
		guiVisible = not guiVisible
		frame.Visible = guiVisible
	end
end)

local minimized = false
local maximized = false

local storedSize = frame.Size
local normalSize = frame.Size

minimizeBtn.MouseButton1Click:Connect(function()

	minimized = not minimized

	if minimized then

		storedSize = frame.Size

		content.Visible = false

		TweenService:Create(
			frame,
			TweenInfo.new(0.2),
			{
				Size = UDim2.fromOffset(
					storedSize.X.Offset,
					30
				)
			}
		):Play()

	else

		content.Visible = true

		TweenService:Create(
			frame,
			TweenInfo.new(0.2),
			{
				Size = storedSize
			}
		):Play()

	end
end)

maximizeBtn.MouseButton1Click:Connect(function()

	if minimized then
		minimized = false
		content.Visible = true

		TweenService:Create(
			frame,
			TweenInfo.new(0.2),
			{
				Size = storedSize
			}
		):Play()

		return
	end

	maximized = not maximized

	local targetSize

if maximized then

	local contentHeight =
		layout.AbsoluteContentSize.Y + 60

	targetSize = UDim2.fromOffset(
		math.max(normalWidth, 450),
		contentHeight
	)

else

	targetSize = UDim2.fromOffset(
		normalWidth,
		layout.AbsoluteContentSize.Y + 60
	)

end

	TweenService:Create(
		frame,
		TweenInfo.new(0.2),
		{
			Size = targetSize
		}
	):Play()
end)

