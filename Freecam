-- Freecam Logic
local active = false
local camCF = camera.CFrame
local yaw, pitch = 0, 0
local dragging = false
local inputs = {
	W = false, A = false, S = false, D = false,
	Up = false, Down = false,
	Boost = false
}

local function setInputs(key, state)
	if key == Enum.KeyCode.W then inputs.W = state end
	if key == Enum.KeyCode.A then inputs.A = state end
	if key == Enum.KeyCode.S then inputs.S = state end
	if key == Enum.KeyCode.D then inputs.D = state end
	if key == Enum.KeyCode.Space or key == Enum.KeyCode.PageUp then inputs.Up = state end
	if key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.PageDown then inputs.Down = state end
	if key == Enum.KeyCode.LeftShift then inputs.Boost = state end
end

local function updatePosDisplay()
	local pos = camera.CFrame.Position
	posBox.Text = string.format("%.2f %.2f %.2f", pos.X, pos.Y, pos.Z)
end

-- Mouse look
UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		dragging = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	elseif input.UserInputType == Enum.UserInputType.Keyboard then
		setInputs(input.KeyCode, true)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		dragging = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	elseif input.UserInputType == Enum.UserInputType.Keyboard then
		setInputs(input.KeyCode, false)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		yaw = yaw - input.Delta.X * 0.002
		pitch = math.clamp(pitch - input.Delta.Y * 0.002, -math.pi/2 + 0.01, math.pi/2 - 0.01)
	end
end)

toggleBtn.MouseButton1Click:Connect(function()
	active = not active
	toggleBtn.Text = active and "End Freecam" or "Start Freecam"

	if active then
		camCF = camera.CFrame
		local look = camCF.LookVector
		yaw = math.atan2(-look.X, -look.Z)
		pitch = math.asin(look.Y)

		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			player.Character.HumanoidRootPart.Anchored = true
		end
		camera.CameraType = Enum.CameraType.Scriptable
	else
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			player.Character.HumanoidRootPart.Anchored = false
		end
		camera.CameraType = Enum.CameraType.Custom
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not active then return end

	local moveVec = Vector3.zero
	if inputs.W then moveVec += Vector3.new(0, 0, -1) end
	if inputs.S then moveVec += Vector3.new(0, 0, 1) end
	if inputs.A then moveVec += Vector3.new(-1, 0, 0) end
	if inputs.D then moveVec += Vector3.new(1, 0, 0) end
	if inputs.Up then moveVec += Vector3.new(0, 1, 0) end
	if inputs.Down then moveVec += Vector3.new(0, -1, 0) end

	local moveSpeed = tonumber(speedBox.Text) or 10
	if inputs.Boost then moveSpeed *= 2 end

	local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	camCF = camCF + rot:VectorToWorldSpace(moveVec * moveSpeed * dt)
	camera.CFrame = CFrame.new(camCF.Position) * rot
	updatePosDisplay()
end)
